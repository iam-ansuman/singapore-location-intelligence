# Copy this file to .env and fill in your own keys.
# .env is ignored by Git, so your keys never reach GitHub.

# LTA DataMall (passenger volume, bus stops): https://datamall.lta.gov.sg
LTA_DATAMALL_API_KEY=

# OneMap (geocoding), only if the endpoint you use needs a token: https://www.onemap.gov.sg/apidocs/
ONEMAP_EMAIL=
ONEMAP_PASSWORD=
